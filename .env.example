# AISOD 3A Harness — environment template
# Copy to .env and fill in your values

# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model provider: "openrouter" | "hermes" | "openai"
AISOD_HARNESS_DEFAULT_MODEL=openrouter

# API server port
AISOD_HARNESS_PORT=8000

# API server host
AISOD_HARNESS_HOST=0.0.0.0

{
  "version": 2,
  "builds": [
    {
      "src": "api_server.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api_server.py"
    }
  ],
  "env": {
    "OPENROUTER_API_KEY": "@openrouter-api-key",
    "AISOD_HARNESS_DEFAULT_MODEL": "openrouter",
    "AISOD_HARNESS_PORT": "8000",
    "AISOD_HARNESS_HOST": "0.0.0.0"
  },
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 300
    }
  }
}

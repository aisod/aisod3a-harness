{
  "version": 2,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "env": {
    "OPENROUTER_API_KEY": "@openrouter-api-key",
    "AISOD_HARNESS_DEFAULT_MODEL": "openrouter",
    "AISOD_HARNESS_PORT": "8000",
    "AISOD_HARNESS_HOST": "0.0.0.0"
  }
}
